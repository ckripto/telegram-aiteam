# Telegram
TELEGRAM_BOT_TOKEN=

# Optional but recommended. If set, messages from other chats are ignored.
# To discover it, run the bot once and send /status in your group; the chat id is logged in storage.
TELEGRAM_ALLOWED_CHAT_ID=

# OpenAI
# If OPENAI_API_KEY or OPENAI_MODEL is empty, the assistant runs in offline fallback mode.
OPENAI_API_KEY=
OPENAI_MODEL=

# Optional per-agent model credentials.
# Senior Python Developer can use a different OpenAI-compatible model and API token.
PYTHON_DEVELOPER_API_KEY=
PYTHON_DEVELOPER_MODEL=
PYTHON_DEVELOPER_BASE_URL=https://api.openai.com/v1

# Runtime
DATABASE_PATH=.data/agent_workspace.sqlite3
POLL_TIMEOUT_SECONDS=30
POLL_INTERVAL_SECONDS=1
PUBLIC_TOOL_EVENTS=true
LOCAL_TIMEZONE=Europe/Moscow
WEATHER_DEFAULT_LOCATION=Moscow
